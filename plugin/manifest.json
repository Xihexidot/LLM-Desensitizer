{
  "manifest_version": 3,
  "name": "DeepSeek 安全网关",
  "version": "1.0",
  "description": "拦截 DeepSeek API 请求，强制经过本地安全网关检查",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}