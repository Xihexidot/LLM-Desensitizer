{
  "name": "ai-input-guard-plugin-tests",
  "version": "1.0.0",
  "private": true,
  "description": "AI 输入安全助手浏览器插件自动化测试环境（Playwright，覆盖 Chromium / Edge）",
  "scripts": {
    "test": "playwright test",
    "test:headed": "cross-env HEADED=1 playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:edge": "playwright test --project=msedge",
    "test:unit": "node --test tests/managed-store.unit.js",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "cross-env": "^7.0.3"
  }
}
